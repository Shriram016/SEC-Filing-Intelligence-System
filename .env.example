# Copy this file to .env and fill in your values. Never commit .env.

# Required: Q&A pipeline, conflict analyzer and evaluation
GROQ_API_KEY=your_groq_key_here

# Optional: Langfuse tracing. Leave these out to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
